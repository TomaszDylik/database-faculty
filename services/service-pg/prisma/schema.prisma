generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum ConversationType {
  DIRECT
  GROUP
}

enum ConversationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  email                String               @unique @db.VarChar(255)
  displayName          String               @map("display_name") @db.VarChar(120)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  createdConversations Conversation[]       @relation("ConversationCreator")
  memberships          ConversationMember[]

  @@map("users")
}

model Conversation {
  id              String               @id @default(uuid()) @db.Uuid
  title           String?              @db.VarChar(255)
  type            ConversationType     @default(DIRECT)
  createdById     String?              @map("created_by_id") @db.Uuid
  status          ConversationStatus   @default(ACTIVE)
  lastMessageAt   DateTime?            @map("last_message_at")
  nextMessageSeq  Int                  @default(1) @map("next_message_seq")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  createdBy       User?                @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members         ConversationMember[]
  messagePointers MessagePointer[]

  @@index([createdById])
  @@index([status])
  @@index([type])
  @@map("conversations")
}

model ConversationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  conversationId String                 @map("conversation_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           ConversationMemberRole @default(MEMBER)
  joinedAt       DateTime               @default(now()) @map("joined_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model MessagePointer {
  conversationId String       @map("conversation_id") @db.Uuid
  seq            Int
  mongoId        String       @unique @map("mongo_id") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@id([conversationId, seq])
  @@map("message_pointers")
}
