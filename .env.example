NODE_ENV=development

POSTGRES_DB=chat_app
POSTGRES_USER=chat_user
POSTGRES_PASSWORD=chat_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://chat_user:chat_password@postgres:5432/chat_app?schema=public

MONGO_INITDB_ROOT_USERNAME=chat_root
MONGO_INITDB_ROOT_PASSWORD=chat_password
MONGO_INITDB_DATABASE=chat_messages
MONGO_PORT=27017
MONGO_URI=mongodb://chat_root:chat_password@mongo:27017/chat_messages?authSource=admin

API_GATEWAY_PORT=8080
SERVICE_PG_PORT=8081
SERVICE_MONGO_PORT=8082
SERVICE_PG_URL=http://service-pg:8081
SERVICE_MONGO_URL=http://service-mongo:8082
